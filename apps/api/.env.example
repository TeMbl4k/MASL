# development | test | production. В production WEB_ORIGINS обязателен.
NODE_ENV=development
# Порт API
PORT=3000
# PostgreSQL + PostGIS (docker compose up -d)
DATABASE_URL=postgres://masl:masl@localhost:5432/masl
# Токен бота от @BotFather: им проверяется подпись initData. С заглушкой API не стартует.
BOT_TOKEN=123456:replace-me
# Секрет для подписи JWT сессий, минимум 32 символа: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Сколько живёт сессия, секунды (по умолчанию 12 часов)
SESSION_TTL_SECONDS=43200
# Сколько секунд initData считается свежей (по умолчанию 1 сутки)
INIT_DATA_MAX_AGE_SECONDS=86400
# Откуда разрешены запросы к API (адрес Mini App, без пути), через запятую.
# В разработке Vite проксирует /api, и этот параметр не нужен.
WEB_ORIGINS=http://localhost:5173
