# development | test | production
NODE_ENV=development
# Порт API
PORT=3000
# PostgreSQL + PostGIS (docker compose up -d)
DATABASE_URL=postgres://masl:masl@localhost:5432/masl
# Токен бота от @BotFather: им проверяется подпись initData. С заглушкой API не стартует.
BOT_TOKEN=123456:replace-me
# Секрет для подписи JWT сессий, минимум 32 символа: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Сколько живёт сессия, секунды (по умолчанию 12 часов)
SESSION_TTL_SECONDS=43200
# Сколько секунд initData считается свежей (по умолчанию 1 сутки)
INIT_DATA_MAX_AGE_SECONDS=86400
# Другие домены, с которых можно ходить в API (CORS), через запятую, без пути.
# Обычно не нужен: Mini App и API работают на одном домене, в разработке Vite проксирует /api.
WEB_ORIGINS=
# Необязательно: ключ DaData для подсказок адресов (dadata.ru → личный кабинет → API-ключ).
# Без него место выбирают точкой на карте. С заглушкой API не стартует, поэтому строка закомментирована.
# DADATA_API_KEY=replace-with-dadata-key
# Каталог сборки Mini App, если она не в apps/web/build (API отдаёт её с того же домена).
# WEB_DIST_DIR=
