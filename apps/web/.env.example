# Адрес API, только если он на другом домене (например https://api.masl.example).
# По умолчанию Mini App ходит в /api на своём домене; в разработке Vite проксирует его на localhost:3000.
VITE_API_URL=
# Только для разработки в обычном браузере: initData, подписанная локальным BOT_TOKEN.
# Сгенерировать: pnpm --filter @masl/api dev:init-data
VITE_DEV_INIT_DATA=
