# Адрес API для сборки, обязателен для деплоя (например https://api.masl.example).
# В разработке можно не задавать: запросы идут на /api, Vite проксирует их на localhost:3000.
VITE_API_URL=
# Только для разработки в обычном браузере: initData, подписанная локальным BOT_TOKEN.
# Сгенерировать: pnpm --filter @masl/api dev:init-data
VITE_DEV_INIT_DATA=
