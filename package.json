{
  "name": "masl",
  "private": true,
  "description": "MASL — Telegram Mini App для спонтанных встреч",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres redis",
    "db:generate": "pnpm --filter @masl/db generate",
    "db:migrate": "pnpm --filter @masl/db migrate",
    "db:seed": "pnpm --filter @masl/db seed"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.4.0",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3"
  }
}
