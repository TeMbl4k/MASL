# Обычно этот файл создаёт deploy/install.sh. Вручную: cp deploy/.env.example deploy/.env
# Адрес сайта. Без своего домена подойдёт IP сервера через sslip.io: 203-0-113-7.sslip.io
DOMAIN=
# Токен бота от @BotFather.
BOT_TOKEN=
# Случайные строки: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Необязательно: ключ DaData для подсказок адресов при создании встречи (dadata.ru → личный кабинет → API-ключ).
# Без него место выбирают точкой на карте. Чтобы включить, раскомментируйте строку и подставьте ключ.
# DADATA_API_KEY=replace-with-dadata-key
# Необязательно: Telegram ID админов через запятую (свой ID подскажет @userinfobot).
# Админ видит «Модерацию» в профиле приложения и назначает модераторов.
ADMIN_TELEGRAM_IDS=
